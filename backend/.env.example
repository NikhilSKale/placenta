# Database and Storage Configuration (Windows / Relative paths)
DATABASE_URL=sqlite:///../storage/application.db
CHROMA_PATH=../storage/chroma
UPLOADS_PATH=../storage/uploads

# Document Ingestion Directories
PLACEMENT_EXPERIENCE_PATH=../placement_experience
POLICY_PATH=../vesit_policy

# Embedding Model (Sentence Transformers)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Local LLM Inference (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120

# RAG Hyperparameters
CHUNK_SIZE=700
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=8
SIMILARITY_THRESHOLD=0.3

# Security & Constraints
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=[".pdf", ".docx", ".txt", ".md"]
